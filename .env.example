# Copy this file to ".env" (never commit the real one) and fill in the values.
# Used by: the backend when run locally, and by docker compose.

# --- Database (local development: a PostgreSQL you run yourself) ---
DB_URL=jdbc:postgresql://localhost:5432/jobtracker
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- Security ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# --- AI (Google Gemini, free tier). Get a key at https://aistudio.google.com/apikey
# Leave empty to run without AI: the form simply works by hand.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# --- Browser origin allowed to call the API (the frontend URL) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Reminder emails (optional). Without MAIL_HOST the reminder is only an in-app notification. ---
# Gmail example: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<app password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# When the daily reminder job runs (Spring cron: second minute hour day month weekday) and in which timezone
REMINDERS_CRON=0 0 8 * * *
REMINDERS_ZONE=UTC

# --- Demo account with sample data (demo@example.com / Demo@1234) ---
SEED_DEMO_DATA=true

# --- docker compose only ---
COMPOSE_DB_PASSWORD=jobtracker
FRONTEND_PORT=3000
BACKEND_PORT=8082
